{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rillswap.invalid/schemas/checkout/native-lightning.schema.json",
  "title": "Native Lightning checkout terms (not receipt evidence)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policyVersion", "merchantOrigin", "intentId", "attemptId", "network", "amountMsat", "paymentHash", "receiver", "expiresAt", "buyerExtraMsat"],
  "properties": {
    "version": { "const": "checkout/0.1" },
    "policyVersion": { "const": "native-lightning/1" },
    "merchantOrigin": { "type": "string", "minLength": 1, "maxLength": 255 },
    "intentId": { "$ref": "#/$defs/id" },
    "attemptId": { "$ref": "#/$defs/id" },
    "network": { "enum": ["regtest", "signet", "mainnet"] },
    "amountMsat": { "$ref": "#/$defs/positive" },
    "buyerExtraMsat": { "$ref": "#/$defs/quantity" },
    "paymentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "receiver": { "type": "string", "pattern": "^(02|03)[0-9a-f]{64}$" },
    "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "positive": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" },
    "quantity": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$" }
  }
}
