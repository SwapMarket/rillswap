{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rillswap.invalid/schemas/wire/evm-contract-terms-v1.schema.json",
  "title": "RillSwap ERC20 to LN (RS-010) and LN to ERC20 (RS-010) contract terms v1",
  "description": "Signed terms for the EVM HTLC profiles. Economic equations, cross-chain timing inequalities, and address distinctness remain normative in RS-010.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "contract_version",
    "profile_id",
    "network_identity",
    "evm_asset",
    "provider_identity_key",
    "client_evm_address",
    "provider_evm_address",
    "claimant",
    "refund_party",
    "invoice_binding",
    "economics",
    "htlc_timelock_block",
    "evm_reference_block",
    "btc_reference_height",
    "funding_confirmations",
    "settlement_confirmations",
    "recovery_authorization_xonly_key",
    "terms_expiry",
    "timing_policy",
    "required_features",
    "extensions"
  ],
  "properties": {
    "protocol": { "const": "rillswap" },
    "contract_version": { "const": "1" },
    "profile_id": { "enum": ["erc20-to-ln/v1", "ln-to-erc20/v1"] },
    "network_identity": { "$ref": "common-v1.schema.json#/$defs/networkIdentity" },
    "evm_asset": { "$ref": "common-v1.schema.json#/$defs/evmAssetIdentity" },
    "provider_identity_key": { "$ref": "common-v1.schema.json#/$defs/hex32" },
    "client_evm_address": { "$ref": "common-v1.schema.json#/$defs/evmAddress" },
    "provider_evm_address": { "$ref": "common-v1.schema.json#/$defs/evmAddress" },
    "claimant": { "enum": ["client", "provider"] },
    "refund_party": { "enum": ["client", "provider"] },
    "invoice_binding": { "$ref": "contract-terms-v1.schema.json#/$defs/invoiceBinding" },
    "economics": { "oneOf": [{ "$ref": "#/$defs/erc20ToLnEconomics" }, { "$ref": "#/$defs/lnToErc20Economics" }] },
    "htlc_timelock_block": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
    "evm_reference_block": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
    "btc_reference_height": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
    "funding_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
    "settlement_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
    "recovery_authorization_xonly_key": { "$ref": "common-v1.schema.json#/$defs/hex32" },
    "terms_expiry": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
    "timing_policy": { "oneOf": [{ "$ref": "#/$defs/erc20ToLnTiming" }, { "$ref": "#/$defs/lnToErc20Timing" }] },
    "required_features": { "$ref": "common-v1.schema.json#/$defs/featureList" },
    "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
  },
  "allOf": [
    {
      "if": { "properties": { "profile_id": { "const": "erc20-to-ln/v1" } } },
      "then": {
        "properties": {
          "claimant": { "const": "provider" },
          "refund_party": { "const": "client" },
          "economics": { "$ref": "#/$defs/erc20ToLnEconomics" },
          "timing_policy": { "$ref": "#/$defs/erc20ToLnTiming" }
        }
      }
    },
    {
      "if": { "properties": { "profile_id": { "const": "ln-to-erc20/v1" } } },
      "then": {
        "properties": {
          "claimant": { "const": "client" },
          "refund_party": { "const": "provider" },
          "economics": { "$ref": "#/$defs/lnToErc20Economics" },
          "timing_policy": { "$ref": "#/$defs/lnToErc20Timing" }
        }
      }
    }
  ],
  "$defs": {
    "signedDecimalTokenUnits": {
      "description": "A fee in token base units; negative when the provider pays a rebate. No -0.",
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]{0,38})$"
    },
    "erc20ToLnEconomics": {
      "description": "lock_amount_token_base = ceil(lightning_principal_sat * rate_token_base_per_btc / 1e8) + success_fee_token_base (RS-010).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lightning_principal_sat", "rate_token_base_per_btc", "success_fee_token_base", "lock_amount_token_base"],
      "properties": {
        "kind": { "const": "erc20-to-ln" },
        "lightning_principal_sat": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "rate_token_base_per_btc": { "$ref": "common-v1.schema.json#/$defs/positiveTokenUnits" },
        "success_fee_token_base": { "$ref": "#/$defs/signedDecimalTokenUnits" },
        "lock_amount_token_base": { "$ref": "common-v1.schema.json#/$defs/positiveTokenUnits" }
      }
    },
    "lnToErc20Economics": {
      "description": "payout_sat_equivalent = ceil(payout_token_base * 1e8 / rate_token_base_per_btc); hold_invoice_sat = payout_sat_equivalent + success_fee_sat (RS-010).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "payout_token_base", "rate_token_base_per_btc", "payout_sat_equivalent", "success_fee_sat", "hold_invoice_sat"],
      "properties": {
        "kind": { "const": "ln-to-erc20" },
        "payout_token_base": { "$ref": "common-v1.schema.json#/$defs/positiveTokenUnits" },
        "rate_token_base_per_btc": { "$ref": "common-v1.schema.json#/$defs/positiveTokenUnits" },
        "payout_sat_equivalent": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" },
        "success_fee_sat": { "$ref": "contract-terms-v1.schema.json#/$defs/signedDecimalSats" },
        "hold_invoice_sat": { "type": "string", "pattern": "^[1-9][0-9]{0,15}$" }
      }
    },
    "erc20ToLnTiming": {
      "description": "(max_outgoing_htlc_expiry_height - btc_reference_height) * 600 + learn_and_claim_seconds < (htlc_timelock_block - evm_reference_block) * block_seconds (RS-010).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "max_outgoing_htlc_expiry_height", "learn_and_claim_seconds"],
      "properties": {
        "kind": { "const": "erc20-to-ln" },
        "max_outgoing_htlc_expiry_height": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "learn_and_claim_seconds": { "$ref": "common-v1.schema.json#/$defs/positiveCount" }
      }
    },
    "lnToErc20Timing": {
      "description": "(htlc_timelock_block - evm_reference_block) * block_seconds + refund_and_ln_resolution_seconds < (min_incoming_htlc_expiry_height - btc_reference_height) * 600 (RS-010).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "min_incoming_htlc_expiry_height", "refund_and_ln_resolution_seconds"],
      "properties": {
        "kind": { "const": "ln-to-erc20" },
        "min_incoming_htlc_expiry_height": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "refund_and_ln_resolution_seconds": { "$ref": "common-v1.schema.json#/$defs/positiveCount" }
      }
    }
  }
}
