{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["bun"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "scripts", "tests", "browser", "examples", "playwright.config.ts"]
}
