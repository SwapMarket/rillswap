# Copy to .env next to compose.yaml and adjust.

# Makers that `docker compose up -d` starts, comma separated. Choose from
# btc-to-ln, ln-to-btc, erc20-to-ln and ln-to-erc20; each needs its own
# `rill-provider-init maker` and `provision-store` first.
COMPOSE_PROFILES=btc-to-ln,ln-to-btc

# Pin a release tag or digest in production, for example :v1.2.3 or @sha256:...
RILL_PROVIDER_IMAGE=ghcr.io/rillswap/rill-provider:latest

# Container user. It must own ./makers, ./stores and ./credentials, because
# the provider refuses custody keys owned by another uid.
RILL_UID=1000
RILL_GID=1000

# Bitcoin Core RPC and LND gRPC as seen from the containers.
# host.docker.internal is the Docker host; Core and LND must listen on an
# address the containers can reach (not only 127.0.0.1), and Core's
# rpcallowip must include the Docker network. Use a service name instead when
# Core or LND run in a container attached to this project's network.
BITCOIN_RPC_HOST=host.docker.internal
BITCOIN_RPC_PORT=8332
LND_GRPC_HOST=host.docker.internal
LND_GRPC_PORT=10009
