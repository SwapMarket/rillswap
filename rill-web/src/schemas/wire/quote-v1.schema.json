{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.rillswap.invalid/schemas/wire/quote-v1.schema.json",
  "title": "RillSwap BTC to LN (RS-003), LN to BTC (RS-004), and ERC20 (RS-010) quote, firm request, terms offer, and error payloads v1",
  "$defs": {
    "sats": { "$ref": "common-v1.schema.json#/$defs/decimalSats" },
    "positiveSats": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,15}$"
    },
    "blockHeight": { "type": "integer", "minimum": 1, "maximum": 499999999 },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_success_fee_sat",
        "max_funding_fee_sat",
        "max_claim_fee_sat",
        "max_refund_fee_sat",
        "max_refund_lock_height"
      ],
      "properties": {
        "max_success_fee_sat": { "$ref": "#/$defs/sats" },
        "max_funding_fee_sat": { "$ref": "#/$defs/sats" },
        "max_claim_fee_sat": { "$ref": "#/$defs/sats" },
        "max_refund_fee_sat": { "$ref": "#/$defs/sats" },
        "max_refund_lock_height": { "$ref": "#/$defs/blockHeight" }
      }
    },
    "indicativeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "lightning_principal_sat", "extensions"],
      "properties": {
        "kind": { "const": "btc-to-ln" },
        "mode": { "const": "indicative" },
        "lightning_principal_sat": { "$ref": "#/$defs/positiveSats" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "firmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "lightning_principal_sat",
        "invoice",
        "client_contract_compressed_key",
        "recovery_authorization_xonly_key",
        "client_destination_script",
        "limits",
        "extensions"
      ],
      "properties": {
        "kind": { "const": "btc-to-ln" },
        "mode": { "const": "firm" },
        "lightning_principal_sat": { "$ref": "#/$defs/positiveSats" },
        "invoice": { "type": "string", "pattern": "^ln[a-z0-9]{1,2046}$" },
        "client_contract_compressed_key": { "$ref": "common-v1.schema.json#/$defs/hex33" },
        "recovery_authorization_xonly_key": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "client_destination_script": { "$ref": "common-v1.schema.json#/$defs/scriptHex" },
        "limits": { "$ref": "#/$defs/limits" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "reverseLimits": {
      "description": "RS-004 LN to BTC client bounds; the client is the claimant.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_success_fee_sat",
        "min_claim_fee_reserve_sat",
        "max_claim_fee_sat",
        "min_refund_lock_height",
        "max_incoming_htlc_expiry_height"
      ],
      "properties": {
        "max_success_fee_sat": { "$ref": "#/$defs/sats" },
        "min_claim_fee_reserve_sat": { "$ref": "#/$defs/sats" },
        "max_claim_fee_sat": { "$ref": "#/$defs/sats" },
        "min_refund_lock_height": { "$ref": "#/$defs/blockHeight" },
        "max_incoming_htlc_expiry_height": { "$ref": "#/$defs/blockHeight" }
      }
    },
    "reverseIndicativeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "nominal_payout_sat", "extensions"],
      "properties": {
        "kind": { "const": "ln-to-btc" },
        "mode": { "const": "indicative" },
        "nominal_payout_sat": { "$ref": "#/$defs/positiveSats" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "reverseFirmRequest": {
      "description": "RS-004 LN to BTC firm request. Semantic rules, such as a version-1 destination script, remain normative in RS-004.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "mode",
        "nominal_payout_sat",
        "payment_hash",
        "client_contract_compressed_key",
        "recovery_authorization_xonly_key",
        "client_destination_script",
        "limits",
        "extensions"
      ],
      "properties": {
        "kind": { "const": "ln-to-btc" },
        "mode": { "const": "firm" },
        "nominal_payout_sat": { "$ref": "#/$defs/positiveSats" },
        "payment_hash": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "client_contract_compressed_key": { "$ref": "common-v1.schema.json#/$defs/hex33" },
        "recovery_authorization_xonly_key": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "client_destination_script": { "$ref": "common-v1.schema.json#/$defs/scriptHex" },
        "limits": { "$ref": "#/$defs/reverseLimits" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "evmAssetRef": {
      "description": "RS-010 client-side asset selection; the provider answers with the complete evmAssetIdentity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_id", "token_contract"],
      "properties": {
        "chain_id": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "token_contract": { "$ref": "common-v1.schema.json#/$defs/evmAddress" }
      }
    },
    "erc20Limits": {
      "description": "RS-010 ERC20 to LN client bounds; the client is the refund party.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_success_fee_token_base", "max_htlc_timelock_block"],
      "properties": {
        "max_success_fee_token_base": { "$ref": "common-v1.schema.json#/$defs/decimalTokenUnits" },
        "max_htlc_timelock_block": { "$ref": "common-v1.schema.json#/$defs/positiveCount" }
      }
    },
    "erc20IndicativeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "lightning_principal_sat", "evm_asset", "extensions"],
      "properties": {
        "kind": { "const": "erc20-to-ln" },
        "mode": { "const": "indicative" },
        "lightning_principal_sat": { "$ref": "#/$defs/positiveSats" },
        "evm_asset": { "$ref": "#/$defs/evmAssetRef" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "erc20FirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "lightning_principal_sat", "invoice", "evm_asset", "client_evm_address", "recovery_authorization_xonly_key", "limits", "extensions"],
      "properties": {
        "kind": { "const": "erc20-to-ln" },
        "mode": { "const": "firm" },
        "lightning_principal_sat": { "$ref": "#/$defs/positiveSats" },
        "invoice": { "type": "string", "pattern": "^ln[a-z0-9]{1,2046}$" },
        "evm_asset": { "$ref": "#/$defs/evmAssetRef" },
        "client_evm_address": { "$ref": "common-v1.schema.json#/$defs/evmAddress" },
        "recovery_authorization_xonly_key": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "limits": { "$ref": "#/$defs/erc20Limits" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "lnToErc20Limits": {
      "description": "RS-010 LN to ERC20 client bounds; the client is the claimant.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_success_fee_sat", "min_htlc_timelock_block", "max_incoming_htlc_expiry_height"],
      "properties": {
        "max_success_fee_sat": { "$ref": "#/$defs/sats" },
        "min_htlc_timelock_block": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "max_incoming_htlc_expiry_height": { "$ref": "#/$defs/blockHeight" }
      }
    },
    "lnToErc20IndicativeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "payout_token_base", "evm_asset", "extensions"],
      "properties": {
        "kind": { "const": "ln-to-erc20" },
        "mode": { "const": "indicative" },
        "payout_token_base": { "$ref": "common-v1.schema.json#/$defs/positiveTokenUnits" },
        "evm_asset": { "$ref": "#/$defs/evmAssetRef" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "lnToErc20FirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mode", "payout_token_base", "payment_hash", "evm_asset", "client_evm_address", "recovery_authorization_xonly_key", "limits", "extensions"],
      "properties": {
        "kind": { "const": "ln-to-erc20" },
        "mode": { "const": "firm" },
        "payout_token_base": { "$ref": "common-v1.schema.json#/$defs/positiveTokenUnits" },
        "payment_hash": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "evm_asset": { "$ref": "#/$defs/evmAssetRef" },
        "client_evm_address": { "$ref": "common-v1.schema.json#/$defs/evmAddress" },
        "recovery_authorization_xonly_key": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "limits": { "$ref": "#/$defs/lnToErc20Limits" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "quoteRequest": {
      "oneOf": [
        { "$ref": "#/$defs/indicativeRequest" },
        { "$ref": "#/$defs/firmRequest" },
        { "$ref": "#/$defs/reverseIndicativeRequest" },
        { "$ref": "#/$defs/reverseFirmRequest" },
        { "$ref": "#/$defs/erc20IndicativeRequest" },
        { "$ref": "#/$defs/erc20FirmRequest" },
        { "$ref": "#/$defs/lnToErc20IndicativeRequest" },
        { "$ref": "#/$defs/lnToErc20FirmRequest" }
      ]
    },
    "erc20QuoteOffer": {
      "description": "RS-010 indicative ERC20 to LN quote; grants no authority.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "indicative", "economics", "evm_asset", "funding_confirmations", "settlement_confirmations", "evm_reference_block", "max_timelock_delay_blocks", "minimum_invoice_remaining_seconds", "expires_at", "extensions"],
      "properties": {
        "kind": { "const": "erc20-to-ln" },
        "indicative": { "const": true },
        "economics": { "$ref": "evm-contract-terms-v1.schema.json#/$defs/erc20ToLnEconomics" },
        "evm_asset": { "$ref": "common-v1.schema.json#/$defs/evmAssetIdentity" },
        "funding_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "settlement_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "evm_reference_block": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "max_timelock_delay_blocks": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "minimum_invoice_remaining_seconds": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "expires_at": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "lnToErc20QuoteOffer": {
      "description": "RS-010 indicative LN to ERC20 quote; the incoming expiry delta must cover the timelock delay plus resolution (RS-010).",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "indicative", "economics", "evm_asset", "funding_confirmations", "settlement_confirmations", "evm_reference_block", "timelock_delay_blocks", "incoming_htlc_expiry_delta_blocks", "expires_at", "extensions"],
      "properties": {
        "kind": { "const": "ln-to-erc20" },
        "indicative": { "const": true },
        "economics": { "$ref": "evm-contract-terms-v1.schema.json#/$defs/lnToErc20Economics" },
        "evm_asset": { "$ref": "common-v1.schema.json#/$defs/evmAssetIdentity" },
        "funding_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "settlement_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "evm_reference_block": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "timelock_delay_blocks": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "incoming_htlc_expiry_delta_blocks": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "expires_at": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "reverseQuoteOffer": {
      "description": "RS-004 indicative LN to BTC quote. The incoming expiry delta must exceed the refund delay (RS-004).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "indicative",
        "economics",
        "funding_confirmations",
        "settlement_confirmations",
        "refund_resolution_confirmations",
        "reference_height",
        "refund_delay_blocks",
        "incoming_htlc_expiry_delta_blocks",
        "max_funding_fee_sat",
        "max_claim_fee_sat",
        "max_refund_fee_sat",
        "expires_at",
        "extensions"
      ],
      "properties": {
        "kind": { "const": "ln-to-btc" },
        "indicative": { "const": true },
        "economics": { "$ref": "contract-terms-v1.schema.json#/$defs/lnToBtcEconomics" },
        "funding_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "settlement_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "refund_resolution_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "reference_height": { "$ref": "#/$defs/blockHeight" },
        "refund_delay_blocks": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "incoming_htlc_expiry_delta_blocks": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "max_funding_fee_sat": { "$ref": "#/$defs/sats" },
        "max_claim_fee_sat": { "$ref": "#/$defs/sats" },
        "max_refund_fee_sat": { "$ref": "#/$defs/sats" },
        "expires_at": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "quoteOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "indicative",
        "economics",
        "funding_confirmations",
        "settlement_confirmations",
        "refund_resolution_confirmations",
        "reference_height",
        "max_refund_delay_blocks",
        "max_funding_fee_sat",
        "max_claim_fee_sat",
        "max_refund_fee_sat",
        "minimum_invoice_remaining_seconds",
        "expires_at",
        "extensions"
      ],
      "properties": {
        "kind": { "const": "btc-to-ln" },
        "indicative": { "const": true },
        "economics": { "$ref": "contract-terms-v1.schema.json#/$defs/btcToLnEconomics" },
        "funding_confirmations": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "settlement_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "refund_resolution_confirmations": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "reference_height": { "$ref": "#/$defs/blockHeight" },
        "max_refund_delay_blocks": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "max_funding_fee_sat": { "$ref": "#/$defs/sats" },
        "max_claim_fee_sat": { "$ref": "#/$defs/sats" },
        "max_refund_fee_sat": { "$ref": "#/$defs/sats" },
        "minimum_invoice_remaining_seconds": { "$ref": "common-v1.schema.json#/$defs/positiveCount" },
        "expires_at": { "$ref": "common-v1.schema.json#/$defs/exactInteger" },
        "extensions": { "$ref": "common-v1.schema.json#/$defs/extensions" }
      }
    },
    "providerTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_hash", "contract_terms", "handshake_hash"],
      "properties": {
        "contract_hash": { "$ref": "common-v1.schema.json#/$defs/hex32" },
        "contract_terms": { "oneOf": [{ "$ref": "contract-terms-v1.schema.json" }, { "$ref": "evm-contract-terms-v1.schema.json" }] },
        "handshake_hash": { "$ref": "common-v1.schema.json#/$defs/hex32" }
      }
    },
    "termsOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "provider_terms_signature"],
      "properties": {
        "terms": { "$ref": "#/$defs/providerTerms" },
        "provider_terms_signature": { "$ref": "common-v1.schema.json#/$defs/signature64" }
      }
    },
    "reverseTermsOffer": {
      "description": "RS-004 LN to BTC and RS-010 LN to ERC20 terms offer. The decoded hold invoice must equal the signed invoice_binding.",
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "provider_terms_signature", "hold_invoice"],
      "properties": {
        "terms": {
          "allOf": [
            { "$ref": "#/$defs/providerTerms" },
            {
              "type": "object",
              "properties": {
                "contract_terms": {
                  "type": "object",
                  "properties": { "profile_id": { "enum": ["ln-to-btc/v1", "ln-to-erc20/v1"] } }
                }
              }
            }
          ]
        },
        "provider_terms_signature": { "$ref": "common-v1.schema.json#/$defs/signature64" },
        "hold_invoice": { "type": "string", "pattern": "^ln[a-z0-9]{1,2046}$" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "amount_out_of_range",
            "capacity_unavailable",
            "invoice_unacceptable",
            "limits_unsatisfiable",
            "request_unacceptable",
            "unsupported_request"
          ]
        },
        "message": { "type": "string", "pattern": "^[ -~]{0,256}$" }
      }
    }
  }
}
