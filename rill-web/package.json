{
  "name": "rill-web",
  "version": "0.1.0-dev.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/rillswap/rillswap/tree/main/rill-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rillswap/rillswap.git",
    "directory": "rill-web"
  },
  "type": "module",
  "scripts": {
    "build": "bun run check:schemas && tsc --noEmit && bun x --bun vite build",
    "build:pages": "bun run check:schemas && tsc --noEmit && bun scripts/build-pages.ts",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:regtest:reverse": "playwright test --config playwright.regtest.config.ts",
    "test:e2e": "playwright test --config playwright.regtest.config.ts",
    "typecheck": "tsc --noEmit",
    "check:schemas": "bun scripts/generate-advertisement-validators.ts --check",
    "check:bolt11-vectors": "bun scripts/generate-bolt11-vectors.ts --check",
    "generate:bolt11-vectors": "bun scripts/generate-bolt11-vectors.ts",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.11",
    "@types/node": "26.6.2",
    "ajv": "8.17.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@noble/curves": "2.0.1",
    "@noble/hashes": "2.0.1",
    "@rillswap/payments": "file:../rill-payments",
    "@scure/base": "2.0.0",
    "@scure/bip32": "2.0.1",
    "@scure/bip39": "2.0.1",
    "age-encryption": "0.3.1",
    "canonicalize": "5.1.0",
    "nostr-tools": "2.25.2",
    "qrcode-generator": "2.0.4"
  }
}
